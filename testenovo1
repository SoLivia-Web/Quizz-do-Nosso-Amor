const MAX=250;let S=null;let raf=null;const app=document.getElementById('app');
const esc=x=>String(x).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=s=>{if(s==null||!isFinite(s))return '—';s=Math.max(0,Math.round(s));return `${Math.floor(s/60)}min ${String(s%60).padStart(2,'0')}s`};
const shuffle=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
function flat(){let out=[];TESTS.forEach((t,ti)=>t.q.forEach((q,qi)=>{let compact=Array.isArray(q[4]);let choices=compact?q[4]:null;out.push({id:ti*10+qi,ti,qi,type:q[0],para:q[1],excerpt:q[2],prompt:q[3],word:q[3],correct:compact?choices[0]:q[4],wrong:compact?choices.slice(1):q[5],explain:compact?q[5]:q[6]})}));return out}
function makeQuestions(){return flat().map(q=>{let choices=shuffle([q.correct,...q.wrong]);return {...q,choices,correctIndex:choices.indexOf(q.correct)}})}
function home(){S=null;document.getElementById('headright').innerHTML='';app.innerHTML=`<section class="hero"><h1>Simulado TEAP — modalidade completa</h1><p>50 questões, cinco textos acadêmicos extensos e análise detalhada de desempenho e tempo. Os textos e alternativas permanecem em inglês; as instruções e o relatório estão em português.</p></section><section class="card"><h2>Como funciona</h2><p>Você terá um único cronômetro para a prova inteira. As respostas podem ser feitas fora de ordem e alteradas até a submissão. O relatório registra o momento da primeira resposta, a última alteração, o intervalo entre respostas e o tempo ativo aproximado.</p><div class="notice"><b>Distribuição:</b> 5 textos × 10 questões = 50 questões · 250 pontos brutos · nota convertida para 0–50.</div><p style="margin-bottom:0"><button class="btn" id="start">Iniciar simulado completo</button></p></section><section class="card"><h2>Textos da prova</h2><div class="grid">${TESTS.map((t,i)=>`<div class="testcard"><b>Texto ${i+1} · ${esc(t.title)}</b><small>${esc(t.topic)}<br>6 parágrafos · 10 questões</small></div>`).join('')}</div></section>`}
function start(){let n=flat().length;if(n!==50)throw Error('Banco inválido: '+n);S={qs:makeQuestions(),answers:Array(50).fill(null),meta:Array.from({length:50},()=>({first:null,last:null,changes:0,active:0,entered:null})),startedAt:performance.now(),wallStarted:Date.now(),submitted:false,current:0,lastTick:performance.now()};render();tick()}
