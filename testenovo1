function textHTML(t,ti){return `<section class="card" id="text${ti}"><h2>Texto ${ti+1} — ${esc(t.title)}</h2><p class="muted"><b>Área:</b> ${esc(t.topic)}</p><div class="reading">${t.paras.map((p,i)=>`<p><span class="pn">${i+1}</span>${esc(p)}</p>`).join('')}</div><div class="gloss"><b>Vocabulário de apoio:</b> ${t.gloss.map(x=>`<span style="margin-left:10px"><b>${esc(x[0])}</b> — ${esc(x[1])}</span>`).join('')}</div>${t.q.map((_,qi)=>questionHTML(ti*10+qi)).join('')}</section>`}
function questionHTML(i){let q=S.qs[i],m=S.meta[i],sel=S.answers[i];let stem=q.type==='vocab'?`In the context of the text, “${q.word}” most nearly means:`:q.type==='pron'?`The word “${q.word}” refers to:`:q.type==='info'?'According to the text, which statement is correct?':q.type==='para'?`Which option best summarizes paragraph ${q.para+1}?`:q.type==='sent'?'What is the meaning of the following sentence?':'Which option best expresses the main idea of the text?';return `<article class="question" id="q${i}" data-q="${i}"><div class="qtop"><span class="qnum">Questão ${i+1} · ${TYPES[q.type].pts} pts</span><span class="qtype">${TYPES[q.type].name}</span></div>${q.excerpt?`<div class="excerpt">${esc(q.excerpt)}</div>`:''}<div class="stem">${esc(stem)}</div><div class="options">${q.choices.map((c,j)=>`<label class="option ${sel===j?'selected':''}"><input type="radio" name="q${i}" value="${j}" ${sel===j?'checked':''}><span class="letter">${'ABCDE'[j]}</span><span>${esc(c)}</span></label>`).join('')}</div>${m.first!==null?`<div class="muted" style="font-size:.78rem;margin-top:8px">Primeira resposta: ${fmt(m.first)} · alterações: ${m.changes}</div>`:''}</article>`}
function bind(){document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>{let i=+b.dataset.go;S.current=i;document.getElementById('q'+i)?.scrollIntoView({behavior:'smooth',block:'start'});});document.querySelectorAll('.question').forEach(a=>a.onclick=()=>{S.current=+a.dataset.q});document.querySelectorAll('input[type=radio]').forEach(r=>r.onchange=()=>choose(r));document.getElementById('submit').onclick=()=>submit();}
function choose(r){let i=+r.name.slice(1),now=performance.now()-S.startedAt; if(S.answers[i]===null){S.meta[i].first=now}else if(S.answers[i]!==+r.value){S.meta[i].changes++}S.meta[i].last=now;S.answers[i]=+r.value;renderPreserve(i)}
function renderPreserve(i){let y=scrollY;render();scrollTo({top:y});document.getElementById('q'+i)?.querySelector('input:checked')?.focus()}
function activeUpdate(){if(!S||S.submitted)return;let now=performance.now(),dt=Math.max(0,now-S.lastTick)/1000;if(!document.hidden&&S.current>=0)S.meta[S.current].active+=dt;S.lastTick=now}
function tick(){if(!S||S.submitted)return;activeUpdate();let sec=(performance.now()-S.startedAt)/1000,txt=new Date(sec*1000).toISOString().slice(11,19);let el=document.getElementById('timer'),big=document.getElementById('bigtime');if(el){el.textContent=txt;el.classList.toggle('warn',sec>2700)}if(big)big.textContent=txt;raf=requestAnimationFrame(tick)}
function submit(){if(!confirm('Finalizar a prova? As respostas não poderão mais ser alteradas.'))return;activeUpdate();S.submitted=true;cancelAnimationFrame(raf);renderResults()}
function resultData(){let total=0,hits=0,answered=0,changed=0,per={};S.qs.forEach((q,i)=>{let m=S.meta[i],ok=S.answers[i]!==null&&S.answers[i]===q.correctIndex, p=per[q.type]??{got:0,max:0,n:0,hits:0,times:[]};p.max+=TYPES[q.type].pts;p.n++;if(S.answers[i]!==null){answered++;p.times.push(m.first/1000);if(ok){total+=TYPES[q.type].pts;p.got+=TYPES[q.type].pts;p.hits++;hits++}}if(m.changes)changed++;per[q.type]=p});return{total,hits,answered,changed,per}}
function renderResults(){let d=resultData(),pct=Math.round(d.total/MAX*100),elapsed=(performance.now()-S.startedAt)/1000,firsts=S.meta.map((m,i)=>m.first===null?null:{i,t:m.first/1000}).filter(Boolean),fast=firsts.slice().sort((a,b)=>a.t-b.t)[0],slow=firsts.slice().sort((a,b)=>b.t-a.t)[0],chron=firsts.slice().sort((a,b)=>a.t-b.t),prevFirst={};chron.forEach((x,n)=>prevFirst[x.i]=n?chron[n-1].t:null);let metric=(label,val)=>`<div class="metric"><b>${val}</b><small>${label}</small></div>`;document.getElementById('headright').innerHTML=`<span class="pill">Prova finalizada</span><span class="timer">${fmt(elapsed)}</span>`;app.innerHTML=`<section class="card result"><h1>Resultado da prova</h1><div class="score"><div class="ring" style="--p:${pct}"><div><b>${d.total/5}</b><small>de 50</small></div></div><div><h2>${pct}% de aproveitamento</h2><p>${d.hits} acertos de 50 · ${50-d.hits} erros ou em branco · ${fmt(elapsed)} de tempo total</p><button class="btn secondary" id="home">Voltar ao início</button></div></div><div class="metricgrid" style="margin-top:18px">${metric('Tempo total',fmt(elapsed))}${metric('Média até a 1ª resposta',firsts.length?fmt(firsts.reduce((a,x)=>a+x.t,0)/firsts.length):'—')}${metric('Mais rápida',fast?`Q${fast.i+1} · ${fmt(fast.t)}`:'—')}${metric('Maior intervalo até 1ª resposta',slow?`Q${slow.i+1} · ${fmt(slow.t)}`:'—')}${metric('Não respondidas',50-d.answered)}${metric('Questões alteradas',d.changed)}</div></section><section class="card"><h2>Análise por categoria</h2><table><thead><tr><th>Categoria</th><th>Pontos</th><th>Aproveitamento</th><th>Média até 1ª resposta</th><th>Erros</th></tr></thead><tbody>${Object.keys(TYPES).map(k=>{let p=d.per[k],avg=p.times.length?p.times.reduce((a,x)=>a+x,0)/p.times.length:null;return `<tr><td>${TYPES[k].name}</td><td>${p.got}/${p.max}</td><td>${Math.round(p.got/p.max*100)}%</td><td>${avg===null?'—':fmt(avg)}</td><td>${p.n-p.hits}</td></tr>`}).join('')}</tbody></table></section><section class="card"><h2>Relatório individual</h2><p class="muted">“1ª resposta” é o tempo desde o início até a primeira seleção. “Última alteração” registra a última seleção feita. “Intervalo” é o tempo entre a primeira resposta desta questão e a primeira resposta anterior registrada; não representa tempo puro de leitura.</p><table><thead><tr><th>Q</th><th>Texto</th><th>Categoria</th><th>Resposta final</th><th>Resultado</th><th>1ª resposta</th><th>Intervalo</th><th>Última alteração</th><th>Alterações</th><th>Ativo aprox.</th></tr></thead><tbody>${S.qs.map((q,i)=>{let m=S.meta[i], interval=m.first===null?null:((m.first-(prevFirst[i]??0))/1000),ok=S.answers[i]!==null&&S.answers[i]===q.correctIndex;return `<tr class="${m.first===null?'':ok?'ok':'bad'}"><td>${i+1}</td><td>${i<10?'Texto 1':i<20?'Texto 2':i<30?'Texto 3':i<40?'Texto 4':'Texto 5'}</td><td>${TYPES[q.type].name}</td><td>${S.answers[i]===null?'—':'ABCDE'[S.answers[i]]}</td><td>${S.answers[i]===null?'Em branco':ok?'Acerto':'Erro'}</td><td>${m.first===null?'—':fmt(m.first/1000)}</td><td>${fmt(interval)}</td><td>${m.last===null?'—':fmt(m.last/1000)}</td><td>${m.changes}</td><td>${fmt(m.active)}</td></tr>`}).join('')}</tbody></table></section><section class="card"><h2>Gabarito comentado</h2>${S.qs.map((q,i)=>{let ok=S.answers[i]!==null&&S.answers[i]===q.correctIndex;return `<article class="question ${ok?'ok':'bad'}"><div class="qtop"><b>Questão ${i+1} · ${ok?'Acerto':'Revisar'}</b><span>${TYPES[q.type].pts} pts</span></div><div class="answerline"><b>Correta:</b> ${'ABCDE'[q.correctIndex]} — ${esc(q.correct)}<br><b>Sua resposta:</b> ${S.answers[i]===null?'Em branco':`${'ABCDE'[S.answers[i]]} — ${esc(q.choices[S.answers[i]])}`}</div><div class="explain">${esc(q.explain)}</div></article>`}).join('')}</section>`;document.getElementById('home').onclick=home}
