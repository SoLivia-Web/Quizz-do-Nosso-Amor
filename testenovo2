<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Simulados TEAP – Treino de Inglês Instrumental</title>
<style>
:root{
  --blue-900:#14295c; --blue-700:#1e429f; --blue-600:#2557c9; --blue-100:#dbe7fb; --blue-50:#eef4fe;
  --bg:#f1f5f9; --card:#ffffff; --ink:#1f2937; --muted:#64748b; --line:#dde3ec;
  --green:#15803d; --green-bg:#dcfce7; --green-line:#86d9a2;
  --red:#b91c1c; --red-bg:#fee2e2; --red-line:#f3a5a5;
  --amber:#92400e; --amber-bg:#fef3c7; --amber-line:#f5d27a;
  --radius:14px;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --serif:Charter,"Bitstream Charter","Sitka Text",Cambria,Georgia,serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.55;font-size:16px}
a{color:var(--blue-600)}
.topbar{background:var(--blue-900);color:#fff;position:sticky;top:0;z-index:20;box-shadow:0 2px 8px rgba(0,0,0,.15)}
.topbar .in{max-width:960px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:12px;justify-content:space-between;flex-wrap:wrap}
.brand{font-weight:700;letter-spacing:.2px;cursor:pointer;display:flex;align-items:center;gap:8px}
.brand small{font-weight:400;opacity:.75}
.tb-right{display:flex;gap:12px;align-items:center;font-size:.9rem;flex-wrap:wrap}
.pill{background:rgba(255,255,255,.14);padding:3px 10px;border-radius:999px;white-space:nowrap}
.pill.time{font-variant-numeric:tabular-nums}
.nav-toggle{background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.28);color:#fff;padding:5px 12px;border-radius:8px;cursor:pointer;font:inherit;font-size:.88rem;display:inline-flex;align-items:center;gap:6px}
.nav-toggle:hover{background:rgba(255,255,255,.28)}
main{max-width:960px;margin:0 auto;padding:20px 16px 80px}
h1,h2,h3{line-height:1.25;margin:0 0 .5em}
.hero{background:linear-gradient(135deg,var(--blue-700),var(--blue-900));color:#fff;border-radius:var(--radius);padding:28px 24px;margin-bottom:20px}
.hero h1{font-size:1.8rem}
.hero p{margin:.3em 0 0;opacity:.92;max-width:62ch}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px;margin-bottom:20px;box-shadow:0 1px 2px rgba(15,23,42,.04)}
.tips{border-left:6px solid #f59e0b;background:#fffbeb}
.tips h2{color:var(--amber);font-size:1.2rem}
.tips ul{margin:.4em 0 0;padding-left:1.2em}
.tips li{margin:.55em 0}
.tips code,.kbd{background:#fde68a;border-radius:4px;padding:0 5px;font-style:italic}
table.pts{width:100%;border-collapse:collapse;font-size:.93rem}
table.pts th,table.pts td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left}
table.pts td:last-child,table.pts th:last-child{text-align:right;white-space:nowrap}
table.pts tfoot td{font-weight:700;border-bottom:none}
.row{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#fff}
.seg button{border:0;background:transparent;padding:7px 14px;cursor:pointer;font:inherit;font-size:.9rem;color:var(--muted)}
.seg button.on{background:var(--blue-600);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.tcard{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px;cursor:pointer;display:flex;flex-direction:column;gap:6px;transition:.15s;text-align:left;font:inherit;color:inherit}
.tcard:hover,.tcard:focus-visible{border-color:var(--blue-600);box-shadow:0 4px 14px rgba(37,87,201,.15);transform:translateY(-2px);outline:none}
.tcard .n{font-size:.78rem;font-weight:700;color:var(--blue-600);text-transform:uppercase;letter-spacing:.06em}
.tcard .t{font-weight:700;font-size:1.05rem}
.tcard .d{color:var(--muted);font-size:.9rem}
.badge{align-self:flex-start;font-size:.8rem;padding:2px 10px;border-radius:999px;background:var(--blue-50);color:var(--blue-700)}
.badge.done{background:var(--green-bg);color:var(--green)}
.full-cta{background:linear-gradient(135deg,#dbe7fb,#eef4fe);border:2px solid var(--blue-600);border-radius:var(--radius);padding:22px;margin-bottom:20px}
.full-cta h2{margin:0 0 .4em;color:var(--blue-900);font-size:1.35rem}
.full-cta p{margin:0 0 14px;color:var(--blue-900);opacity:.85;max-width:60ch}
.full-cta .meta{display:flex;gap:14px;flex-wrap:wrap;font-size:.88rem;color:var(--blue-700);margin-bottom:14px}
.full-cta .meta b{color:var(--blue-900)}
.btn{display:inline-block;border:0;border-radius:10px;padding:12px 22px;font:inherit;font-weight:600;cursor:pointer;background:var(--blue-600);color:#fff;transition:.15s}
.btn:hover{background:var(--blue-700)}
.btn.ghost{background:#fff;color:var(--blue-700);border:1px solid var(--blue-600)}
.btn.ghost:hover{background:var(--blue-50)}
.btn.big{padding:15px 30px;font-size:1.05rem}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.back{background:none;border:0;color:var(--blue-700);cursor:pointer;font:inherit;padding:0;margin-bottom:12px}
.textcard h2{font-size:1.25rem;color:var(--blue-900)}
.textcard h3{font-size:1.1rem;color:var(--blue-900);margin-top:0}
.reading{font-family:var(--serif);font-size:1.1rem;line-height:1.75}
.reading p{margin:0 0 .9em;display:flex;gap:10px}
.pn{flex:none;font-family:var(--sans);font-size:.75rem;font-weight:700;color:var(--blue-600);background:var(--blue-50);border-radius:6px;height:1.7em;min-width:1.7em;display:inline-flex;align-items:center;justify-content:center;margin-top:.25em}
.gloss{background:var(--blue-50);border-radius:10px;padding:12px 16px;font-size:.93rem;margin-top:8px}
.gloss b{color:var(--blue-900)}
.gloss ul{margin:.3em 0 0;padding-left:1.1em}
.q{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-bottom:16px;scroll-margin-top:80px}
.q.highlight{box-shadow:0 0 0 3px rgba(37,87,201,.35);border-color:var(--blue-600)}
.q-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;flex-wrap:wrap;margin-bottom:8px}
.q-num{font-weight:700;color:var(--blue-900)}
.q-num .src{font-weight:400;font-size:.82rem;color:var(--muted);margin-left:6px}
.q-meta{font-size:.78rem;color:var(--muted);background:var(--bg);border-radius:999px;padding:2px 10px}
.stem{font-weight:600;margin:6px 0 10px}
blockquote.ex{margin:0 0 12px;padding:12px 14px;border-left:4px solid var(--blue-100);background:#f8fafc;border-radius:0 10px 10px 0;font-family:var(--serif);font-size:1.02rem;line-height:1.7;display:flex;gap:10px}
mark{background:#fde047;color:#111;padding:0 3px;border-radius:3px;font-weight:700}
.opts{display:grid;gap:8px}
.opt{display:flex;gap:12px;align-items:flex-start;border:1.5px solid var(--line);border-radius:10px;padding:10px 12px;cursor:pointer;transition:.12s;background:#fff;position:relative}
.opt:hover{border-color:var(--blue-600);background:var(--blue-50)}
.opt input{position:absolute;opacity:0;pointer-events:none}
.opt .lt{flex:none;width:28px;height:28px;border-radius:50%;border:2px solid #b8c2d3;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;color:var(--muted);background:#fff}
.opt.sel{border-color:var(--blue-600);background:var(--blue-50)}
.opt.sel .lt{background:var(--blue-600);border-color:var(--blue-600);color:#fff}
.opt:focus-within{outline:3px solid rgba(37,87,201,.35)}
.rv .opt{cursor:default}
.rv .opt:hover{background:#fff;border-color:var(--line)}
.rv .opt.ok{border-color:var(--green-line);background:var(--green-bg)}
.rv .opt.ok .lt{background:var(--green);border-color:var(--green);color:#fff}
.rv .opt.bad{border-color:var(--red-line);background:var(--red-bg)}
.rv .opt.bad .lt{background:var(--red);border-color:var(--red);color:#fff}
.tag{margin-left:auto;font-size:.75rem;font-weight:700;white-space:nowrap;align-self:center;padding-left:8px}
.ok .tag{color:var(--green)} .bad .tag{color:var(--red)}
.expl{margin-top:12px;border-radius:10px;padding:12px 14px;font-size:.95rem}
.expl.good{background:var(--green-bg);border:1px solid var(--green-line)}
.expl.miss{background:var(--amber-bg);border:1px solid var(--amber-line)}
.expl b{display:block;margin-bottom:2px}
.sticky-submit{position:sticky;bottom:0;background:linear-gradient(transparent,var(--bg) 35%);padding:26px 0 14px;text-align:center;z-index:10}
.result{border:2px solid var(--blue-600)}
.score{display:flex;gap:22px;align-items:center;flex-wrap:wrap}
.ring{width:132px;height:132px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--blue-600) calc(var(--p)*1%),var(--blue-100) 0)}
.ring div{width:104px;height:104px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring b{font-size:1.7rem;line-height:1;color:var(--blue-900)} .ring span{font-size:.8rem;color:var(--muted)}
.bars{display:grid;gap:10px;margin-top:16px}
.bar .lbl{display:flex;justify-content:space-between;font-size:.88rem;gap:8px}
.bar .tr{height:10px;background:var(--blue-100);border-radius:999px;overflow:hidden;margin-top:3px}
.bar .fl{height:100%;background:var(--green);border-radius:999px}
.bar.low .fl{background:#ef4444}
.bar.mid .fl{background:#f59e0b}
.note{font-size:.85rem;color:var(--muted)}
footer{max-width:960px;margin:0 auto;padding:0 16px 40px;color:var(--muted);font-size:.82rem}
.startCard{background:linear-gradient(135deg,#eef4fe,#dbe7fb);border-color:#b8c9ec}
.startCard h2{margin:0 0 .3em;color:var(--blue-900);font-size:1.3rem}
.startCard p{margin:0 0 14px;color:var(--blue-900);opacity:.85}
.run-banner{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.run-banner .lbl{font-weight:700;color:var(--green)}
.big-timer{font-variant-numeric:tabular-nums;font-size:1.9rem;font-weight:800;color:var(--blue-900);letter-spacing:.03em}
.run-dot{width:12px;height:12px;border-radius:50%;background:var(--green);animation:pulse 1.6s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(21,128,61,.6)}70%{box-shadow:0 0 0 10px rgba(21,128,61,0)}100%{box-shadow:0 0 0 0 rgba(21,128,61,0)}}
.opt.locked{cursor:not-allowed;opacity:.72}
.opt.locked:hover{border-color:var(--line);background:#fff}
.pre-note{background:var(--amber-bg);border:1px solid var(--amber-line);color:var(--amber);border-radius:10px;padding:10px 14px;font-size:.92rem;margin-bottom:12px}
.progress-bar{height:6px;background:var(--blue-100);border-radius:999px;overflow:hidden;margin-top:8px}
.progress-bar .fill{height:100%;background:var(--green);border-radius:999px;transition:width .3s}
.text-section{margin-bottom:24px}
.text-section .text-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.text-section .text-head h2{margin:0;font-size:1.35rem}
.text-section .text-head .topic{font-size:.85rem;color:var(--muted);background:var(--blue-50);padding:3px 10px;border-radius:999px}

/* Nav panel */
.nav-panel{position:fixed;top:0;right:-380px;width:360px;max-width:92vw;height:100vh;background:#fff;box-shadow:-4px 0 24px rgba(15,23,42,.18);z-index:50;transition:right .25s ease;display:flex;flex-direction:column}
.nav-panel.open{right:0}
.nav-panel .np-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);background:var(--blue-900);color:#fff}
.nav-panel .np-head h3{margin:0;font-size:1rem}
.nav-panel .np-close{background:transparent;border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:8px;padding:4px 10px;cursor:pointer;font:inherit}
.nav-panel .np-body{flex:1;overflow-y:auto;padding:12px 14px}
.nav-panel .np-group{margin-bottom:14px}
.nav-panel .np-group h4{margin:0 0 6px;font-size:.82rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.nav-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.nav-btn{border:1.5px solid var(--line);background:#fff;border-radius:8px;padding:7px 0;font:inherit;font-size:.85rem;font-weight:600;cursor:pointer;color:var(--ink);position:relative;transition:.12s}
.nav-btn:hover{border-color:var(--blue-600);background:var(--blue-50)}
.nav-btn.answered{border-color:var(--green);background:var(--green-bg);color:var(--green)}
.nav-btn.changed{border-color:var(--amber);background:var(--amber-bg);color:var(--amber)}
.nav-btn.active{box-shadow:0 0 0 2px var(--blue-600)}
.nav-btn .dot{position:absolute;top:3px;right:4px;width:6px;height:6px;border-radius:50%;background:var(--amber)}
.nav-overlay{position:fixed;inset:0;background:rgba(15,23,42,.35);z-index:40;opacity:0;pointer-events:none;transition:opacity .2s}
.nav-overlay.on{opacity:1;pointer-events:auto}

/* Timing report */
.timing-block{margin-top:18px;border-top:1px dashed var(--line);padding-top:16px}
.timing-block h3{margin:0 0 10px;color:var(--blue-900);font-size:1.15rem}
.timing-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px}
.kpi{background:var(--blue-50);border-radius:10px;padding:10px 12px}
.kpi .k{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.kpi .v{font-size:1.15rem;font-weight:700;color:var(--blue-900);font-variant-numeric:tabular-nums}
.kpi .v small{font-size:.78rem;font-weight:400;color:var(--muted)}
.timing-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
table.timing-table{width:100%;border-collapse:collapse;font-size:.82rem;min-width:820px}
table.timing-table th,table.timing-table td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left}
table.timing-table th{background:var(--blue-50);color:var(--blue-900);font-weight:700;position:sticky;top:0}
table.timing-table tr.slow td{background:#fef3c7}
table.timing-table tr.wrong td{background:#fee2e2}
table.timing-table tr.blank td{color:var(--muted);font-style:italic}
table.timing-table td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
.cat-tbl{width:100%;border-collapse:collapse;font-size:.88rem;margin-top:8px}
.cat-tbl th,.cat-tbl td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:left}
.cat-tbl th{background:var(--blue-50);color:var(--blue-900)}
.cat-tbl td.num{text-align:right;font-variant-numeric:tabular-nums}
@media (max-width:600px){
  .hero h1{font-size:1.45rem} .reading{font-size:1.04rem} .card{padding:16px} .q{padding:14px}
  .tb-right .pill.hide-m{display:none}
  .nav-panel{width:100%;right:-100%}
  .nav-grid{grid-template-columns:repeat(5,1fr)}
  .score{flex-direction:column;align-items:flex-start}
}
</style>
</head>
