function startTest(id){
  const test=TESTS.find(t=>t.id===id); if(!test){location.hash="#/";return}
  stopClocks(); closeNav();
  // Flat list of questions with textIdx=0
  const qs = test.q.map((q,i)=>({...q, textIdx:0, qIdxInText:i}));
  S = makeState('single',[test],qs,MAX_SINGLE,id);
  renderSingleTest();
  window.scrollTo(0,0);
}

function startFullExam(){
  stopClocks(); closeNav();
  const questions = [];
  FULL_TEXTS.forEach((t,ti)=>{
    t.q.forEach((q,qi)=>{ questions.push({...q, textIdx:ti, qIdxInText:qi}); });
  });
  S = makeState('full', FULL_TEXTS, questions, MAX_FULL, 'full');
  renderFullExam();
  window.scrollTo(0,0);
}

