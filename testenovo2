function buildSingleTests(){
  return RAW.map((t,i)=>({
    id:i+1, title:t.title, topic:t.topic, gloss:t.gloss, paras:t.paras,
    q:t.q.map((r,k)=>({t:r[0],p:r[1],m:r[2],w:r[3],correct:r[4],wrong:r[5],e:r[6],pts:TYPES[r[0]].pts,n:k+1}))
  }));
}
function buildFullTexts(){
  return FULL_RAW.map((t,ti)=>{
    const qs = t.q.map((r,qi)=>({
      t:r[0], p:r[1], m:r[2], w:r[3], correct:r[4], wrong:r[5], e:r[6],
      pts:TYPES[r[0]].pts,
      n: ti*10 + qi + 1,          // numeração global 1-50
      textIdx: ti,
      qIdxInText: qi
    }));
    return {
      title:t.title, topic:t.topic, gloss:t.gloss, paras:t.paras, q:qs,
      textIdx:ti
    };
  });
}
