/* ============================================================
   CRONÔMETROS (geral + ativo por questão)
   ============================================================ */
function stopClocks(){
  clearInterval(displayTimer);
  clearInterval(activeTimer);
  displayTimer = null;
  activeTimer = null;
}

function startClocks(){
  stopClocks();
  if(!S) return;
  displayTimer = setInterval(()=>{
    const el = document.getElementById("timer");
    if(el) el.textContent = S.started ? fmt(getElapsedSec()) : "⏸";
    const bt = document.getElementById("bigTimer");
    if(bt) bt.textContent = fmt(getElapsedSec());
  }, 500);

  // Acumula tempo ativo por questão com base na questão "mais visível"
  activeTimer = setInterval(accumulateActiveTime, 500);
}

function accumulateActiveTime(){
  if(!S || !S.started || S.submitted) return;
  const now = performance.now();
  const active = findMostVisibleQuestionIdx();

  if(S.activeQ !== active){
    // Fecha o anterior
    if(S.activeQ !== null && S.lastTick !== null){
      S.timing[S.activeQ].activeTimeMs += (now - S.lastTick);
    }
    S.activeQ = active;
    S.lastTick = now;
  } else if(S.activeQ !== null){
    S.timing[S.activeQ].activeTimeMs += (now - S.lastTick);
    S.lastTick = now;
  }
  // Se active for null (nada visível), também fecha o anterior
  if(active === null && S.activeQ !== null){
    S.timing[S.activeQ].activeTimeMs += (now - S.lastTick);
    S.activeQ = null; S.lastTick = now;
  }
}

function findMostVisibleQuestionIdx(){
  const nodes = document.querySelectorAll(".q[data-qidx]");
  let best = null, bestScore = 0;
  const vh = window.innerHeight || document.documentElement.clientHeight;
  nodes.forEach(el => {
    const r = el.getBoundingClientRect();
    const visible = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
    const score = visible / Math.max(1, r.height);
    if(score > bestScore && visible > 40){ bestScore = score; best = +el.dataset.qidx; }
  });
  return best;
}

/* ============================================================
   RENDER DAS QUESTÕES
   ============================================================ */
function drawQuestions(){
  if(S.mode==='single'){
    const wrap = document.getElementById("qs"); if(!wrap) return;
    const locked = !S.started;
    wrap.innerHTML = (locked && !S.submitted ? preNote() : "") +
      S.questions.map((q,i)=>renderQuestion(i)).join("");
  } else {
    // Distribui as 50 questões pelos 5 grupos (data-text="0..4")
    S.tests.forEach((_,ti)=>{
      const group = document.querySelector(`.qs-group[data-text="${ti}"]`);
      if(!group) return;
      const start = ti*10, end = start+10;
      let html = (ti===0 && !S.started && !S.submitted) ? preNote() : "";
      for(let i=start;i<end;i++){ html += renderQuestion(i); }
      group.innerHTML = html;
    });
  }
}

function preNote(){
  return `<div class="pre-note">▶ Clique em <b>Iniciar simulado</b> acima para liberar as questões. Você já pode ler o texto.</div>`;
}

function renderQuestion(i){
  const q = S.questions[i];
  const opts = S.opts[i];
  const rv = S.submitted;
  const locked = !S.started;
  const srcLabel = S.mode==='full' ? ` · Texto ${q.textIdx+1}` : "";
  const optHtml = opts.map((o,j)=>{
    const chosen = S.answers[i]===j;
    let cls = "opt";
    if(locked) cls+=" locked";
    if(rv){
      if(o.ok) cls+=" ok";
      else if(chosen) cls+=" bad";
    } else if(chosen) cls+=" sel";
    const tag = rv
      ? (o.ok ? `<span class="tag">✔ Gabarito${chosen?" · sua resposta":""}</span>` : (chosen?`<span class="tag">✘ Sua resposta</span>`:""))
      : "";
    const dis = rv || locked;
    return `<label class="${cls}"><input type="radio" name="q${i}" value="${j}" ${chosen?"checked":""} ${dis?"disabled":""}><span class="lt">${L(j)}</span><span>${o.txt}</span>${tag}</label>`;
  }).join("");
  let expl = "";
  if(rv){
    const okAns = S.answers[i]!==null && S.opts[i][S.answers[i]].ok;
    const li = S.opts[i].findIndex(o=>o.ok);
    expl = `<div class="expl ${okAns?"good":"miss"}"><b>${okAns?"✔ Correto!":(S.answers[i]===null?"Em branco.":"✘ Não foi dessa vez.")} Resposta: ${L(li)}</b>${q.e}</div>`;
  }
  return `<article class="q ${rv?"rv":""}" id="q${i}" data-qidx="${i}">
    <div class="q-head">
      <span class="q-num">Questão ${q.n}<span class="src">${srcLabel}</span></span>
      <span class="q-meta">${TYPES[q.t].name} · ${q.pts} pts</span>
    </div>
    <div class="stem">${stemText(q)}</div>
    ${excerpt(q, S.tests)}
    <div class="opts">${optHtml}</div>${expl}</article>`;
}

function updateCount(){
  const n = S.answers.filter(a=>a!==null).length;
  const el = document.getElementById("cnt");
  if(!el) return;
  if(S.submitted) return; // será sobrescrito no relatório
  el.textContent = `${n}/${S.questions.length} respondidas`;
}

function updateProgress(){
  const bar = document.querySelector("#progressBar .fill"); if(!bar) return;
  const n = S.answers.filter(a=>a!==null).length;
  bar.style.width = `${Math.round(n/S.questions.length*100)}%`;
}

function updateSubmitBar(){
  const bar=document.getElementById("submitBar");
  const btn=document.getElementById("submit");
  if(!bar||!btn) return;
  if(S.submitted){ bar.style.display="none"; return; }
  bar.style.display="";
  if(!S.started){ btn.disabled=true; btn.textContent="Inicie o simulado para responder"; }
  else { btn.disabled=false; btn.textContent = S.mode==='full' ? "Enviar / Corrigir Prova (50 questões)" : "Enviar / Corrigir Prova"; }
}

/* ============================================================
   NAV PANEL (50 questões)
   ============================================================ */
function buildNavPanel(){
  if(!S || S.mode!=='full'){ navBody.innerHTML=""; return; }
  let html = "";
  S.tests.forEach((t,ti)=>{
    html += `<div class="np-group"><h4>Texto ${ti+1} · ${t.title}</h4><div class="nav-grid">`;
    for(let k=0;k<10;k++){
      const i = ti*10+k;
      const q = S.questions[i];
      const ans = S.answers[i];
      const tinfo = S.timing[i];
      const changed = tinfo.changeCount > 1;
      const answered = ans !== null;
      let cls = "nav-btn";
      if(answered) cls += " answered";
      if(changed) cls += " changed";
      html += `<button class="${cls}" data-jump="${i}" title="Questão ${q.n} — ${TYPES[q.t].name}">${q.n}${changed?'<span class="dot"></span>':''}</button>`;
    }
    html += `</div></div>`;
  });
  navBody.innerHTML = html;
}
function refreshNavPanel(){
  if(!S || S.mode!=='full') return;
  navBody.querySelectorAll(".nav-btn").forEach(btn=>{
    const i = +btn.dataset.jump;
    const ans = S.answers[i];
    const tinfo = S.timing[i];
    const changed = tinfo.changeCount > 1;
    btn.classList.toggle("answered", ans!==null);
    btn.classList.toggle("changed", changed);
    const hasDot = btn.querySelector(".dot");
    if(changed && !hasDot){
      const d = document.createElement("span"); d.className="dot"; btn.appendChild(d);
    } else if(!changed && hasDot){ hasDot.remove(); }
  });
  // marcar ativa
  navBody.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
  if(S.activeQ!==null){
    const b = navBody.querySelector(`.nav-btn[data-jump="${S.activeQ}"]`);
    if(b) b.classList.add("active");
  }
}
function openNav(){
  if(!S || S.mode!=='full') return;
  buildNavPanel(); refreshNavPanel();
  navPanel.classList.add("open"); navPanel.setAttribute("aria-hidden","false");
  navOverlay.classList.add("on");
}
function closeNav(){
  navPanel.classList.remove("open"); navPanel.setAttribute("aria-hidden","true");
  navOverlay.classList.remove("on");
}
function jumpToQuestion(i){
  const el = document.getElementById("q"+i);
  if(el){
    closeNav();
    el.scrollIntoView({behavior:"smooth",block:"start"});
    el.classList.add("highlight");
    setTimeout(()=>el.classList.remove("highlight"), 1400);
  }
}

/* ============================================================
   SUBMISSÃO E RESULTADO
   ============================================================ */
function submit(){
  if(!S || !S.started || S.submitted) return;
  const blank = S.answers.filter(a=>a===null).length;
  if(blank && !confirm(`Você deixou ${blank} questão(ões) em branco. Corrigir mesmo assim?`)) return;

  // Fecha o tempo ativo em andamento
  if(S.activeQ !== null && S.lastTick !== null){
    S.timing[S.activeQ].activeTimeMs += (performance.now() - S.lastTick);
    S.lastTick = performance.now();
  }
  S.submitted = true;
  stopClocks();
  drawStartCard();
  closeNav();

  const secs = getElapsedSec();
  const per = {}; let score=0, hits=0;
  S.questions.forEach((q,i)=>{
    const ok = S.answers[i]!==null && S.opts[i][S.answers[i]].ok;
    if(!per[q.t]) per[q.t] = {got:0,max:0,n:0,hit:0,timeSum:0,timeN:0};
    per[q.t].max += q.pts; per[q.t].n++;
    if(ok){ score+=q.pts; hits++; per[q.t].got+=q.pts; per[q.t].hit++; }
    const fa = S.timing[i].firstAnswerAt;
    if(fa!==null){ per[q.t].timeSum += fa; per[q.t].timeN++; }
  });

  // Persistência
  if(S.mode==='full'){
    const prev = bestFull();
    if(prev===null || score>prev) lsSet("best_full", String(score));
  } else {
    const prev = best(S.testId);
    if(prev===null || score>prev) lsSet("best_"+S.testId, String(score));
  }

  const rawPct = Math.round(score / S.maxScore * 100);
  const displayScore = S.mode==='full' ? (score/5) : score;
  const displayMax   = S.mode==='full' ? 50 : S.maxScore;

  const msg = rawPct>=80 ? "Excelente! Você domina bem o estilo da prova."
            : rawPct>=60 ? "Bom desempenho. Revise os tipos em que perdeu pontos."
            : rawPct>=40 ? "Você está no caminho. Estude os comentários e refaça."
            : "Releia as dicas no topo e estude o gabarito comentado com calma.";

  const keys = Object.keys(TYPES);
  const bars = keys.map(k=>{
    const p = per[k]; if(!p) return "";
    const r = p.got / p.max;
    return `<div class="bar ${r<.5?"low":r<.8?"mid":""}"><div class="lbl"><span>${TYPES[k].name}</span><span>${p.got}/${p.max} pts · ${p.hit}/${p.n} ${p.n>1?"acertos":"acerto"}</span></div><div class="tr"><div class="fl" style="width:${Math.round(r*100)}%"></div></div></div>`;
  }).join("");

  // Ponto de atenção
  let weak = null;
  keys.forEach(k=>{
    const p=per[k]; if(!p) return;
    const r=p.got/p.max;
    if(!weak || r<weak.r) weak = {k, r};
  });
  const advice = weak && weak.r<1
    ? `<p><b>Ponto de atenção: ${TYPES[weak.k].name}.</b> ${TYPES[weak.k].tip}</p>`
    : `<p><b>Gabarito perfeito!</b> Tente outro simulado para manter o ritmo.</p>`;

  const next = (S.mode==='single' && S.testId < TESTS.length) ? S.testId+1 : null;

  const prevBest = S.mode==='full' ? bestFull() : best(S.testId);
  const prevBestNote = prevBest!==null && score <= prevBest
    ? (S.mode==='full' ? `Melhor nota anterior: ${(prevBest/5).toFixed(1)}/50.` : `Melhor nota anterior: ${prevBest}/${MAX_SINGLE}.`)
    : "Nova melhor nota neste simulado!";

  let extra = "";
  if(S.mode==='full') extra = renderFullTimingReport(score, secs, per);

  document.getElementById("result").innerHTML=`
  <section class="card result" id="resCard">
    <h2>Resultado${S.mode==='full'?" · Simulado Completo":""}</h2>
    <div class="score">
      <div class="ring" style="--p:${rawPct}"><div><b>${displayScore.toFixed(1)}</b><span>de ${displayMax}</span></div></div>
      <div>
        <div style="font-size:1.5rem;font-weight:700;color:var(--blue-900)">${rawPct}% de acerto</div>
        <div>${hits} de ${S.questions.length} questões corretas · tempo total: ${fmt(secs)}</div>
        <div class="note" style="margin:.3em 0 0">${S.mode==='full' ? `Pontos brutos: ${score}/${S.maxScore} → nota ${displayScore.toFixed(1)}/50.` : `Pontuação: ${score}/${S.maxScore}.`} ${prevBestNote}</div>
        <p style="margin:.4em 0 0">${msg}</p>
      </div>
    </div>
    <div class="bars">${bars}</div>
    <div style="margin-top:14px">${advice}</div>
    <div class="row" style="margin-top:12px;justify-content:flex-start">
      <button class="btn" data-open="${S.mode==='full'?'full':S.testId}">Refazer este simulado</button>
      ${next?`<button class="btn ghost" data-open="${next}">Próximo simulado →</button>`:""}
      <button class="btn ghost" data-home>Todos os simulados</button>
    </div>
    <p class="note" style="margin-bottom:0">Role a página para ver o gabarito comentado de cada questão.</p>
  </section>
  ${extra}`;

  document.getElementById("submitBar").style.display="none";
  drawQuestions();
  updateCount();
  const cnt = document.getElementById("cnt");
  if(cnt) cnt.textContent = `${score}/${S.maxScore} pts`;
  refreshNavPanel();
  document.getElementById("resCard").scrollIntoView({behavior:"smooth",block:"start"});
}

/* ============================================================
   RELATÓRIO TEMPORAL (só para 50 questões)
   ============================================================ */
function renderFullTimingReport(rawScore, totalSecs, per){
  // 1. Indicadores gerais
  const answeredIdxs = [];
  const unansweredIdxs = [];
  const changedIdxs = [];
  S.questions.forEach((q,i)=>{
    if(S.answers[i]===null) unansweredIdxs.push(i); else answeredIdxs.push(i);
    if(S.timing[i].changeCount > 1) changedIdxs.push(i);
  });

  // Média até primeira resposta (apenas respondidas)
  let sumFirst = 0, nFirst = 0;
  answeredIdxs.forEach(i=>{
    const fa = S.timing[i].firstAnswerAt;
    if(fa!==null){ sumFirst += fa; nFirst++; }
  });
  const avgFirst = nFirst ? sumFirst / nFirst : null;

  // Mais rápida (menor activeTimeMs entre as respondidas)
  let fastest = null;
  answeredIdxs.forEach(i=>{
    const at = S.timing[i].activeTimeMs;
    if(!fastest || at < fastest.at) fastest = {i, at};
  });

  // Maior intervalo até primeira resposta (gap entre respostas cronologicamente)
  const firstSorted = answeredIdxs
    .filter(i => S.timing[i].firstAnswerAt !== null)
    .map(i => ({i, t:S.timing[i].firstAnswerAt}))
    .sort((a,b)=>a.t - b.t);
  let maxGap = {i:null, gap:0, prevT:0};
  firstSorted.forEach((cur,k)=>{
    const prevT = k===0 ? 0 : firstSorted[k-1].t;
    const gap = cur.t - prevT;
    if(gap > maxGap.gap) maxGap = {i:cur.i, gap, prevT};
  });

  // 2. Tabela por categoria
  const keys = Object.keys(TYPES);
  const catRows = keys.map(k=>{
    const p = per[k]; if(!p) return "";
    const pct = Math.round(p.got/p.max*100);
    const avgT = p.timeN ? (p.timeSum/p.timeN) : null;
    return `<tr>
      <td>${TYPES[k].name}</td>
      <td class="num">${p.got}/${p.max}</td>
      <td class="num">${pct}%</td>
      <td class="num">${avgT!==null?fmtMs(avgT):"—"}</td>
      <td class="num">${p.hit}/${p.n}</td>
      <td class="num">${p.n - p.hit}</td>
    </tr>`;
  }).join("");

  // 3. Tabela individual (50 linhas)
  // Marca como "slow" o top 20% em firstAnswerAt entre as respondidas
  const firstTimes = answeredIdxs.map(i=>S.timing[i].firstAnswerAt).filter(t=>t!==null).sort((a,b)=>a-b);
  const slowThreshold = firstTimes.length
    ? firstTimes[Math.floor(firstTimes.length*0.8)] || firstTimes[firstTimes.length-1]
    : Infinity;

  const rowsHtml = S.questions.map((q,i)=>{
    const ans = S.answers[i];
    const tinfo = S.timing[i];
    const rvOk = ans!==null && S.opts[i][ans].ok;
    let trCls = "";
    if(ans===null) trCls = "blank";
    else if(!rvOk) trCls = "wrong";
    else if(tinfo.firstAnswerAt!==null && tinfo.firstAnswerAt >= slowThreshold) trCls = "slow";
    const ansLabel = ans===null ? "—" : L(ans);
    const resLabel = ans===null ? "Em branco" : (rvOk ? "✔" : "✘ ("+L(S.opts[i].findIndex(o=>o.ok))+")");
    return `<tr class="${trCls}">
      <td class="num">${q.n}</td>
      <td class="num">T${q.textIdx+1}</td>
      <td>${TYPES[q.t].name}</td>
      <td class="num">${ansLabel}</td>
      <td>${resLabel}</td>
      <td class="num">${tinfo.firstAnswerAt!==null?fmtMs(tinfo.firstAnswerAt):"—"}</td>
      <td class="num">${tinfo.lastChangeAt!==null?fmtMs(tinfo.lastChangeAt):"—"}</td>
      <td class="num">${Math.round(tinfo.activeTimeMs/1000)}s</td>
      <td class="num">${tinfo.changeCount}</td>
    </tr>`;
  }).join("");

  return `
  <section class="card timing-block" id="timingReport">
    <h3>📊 Relatório temporal · 50 questões</h3>
    <div class="timing-kpis">
      <div class="kpi"><div class="k">Tempo total</div><div class="v">${fmt(totalSecs)}</div></div>
      <div class="kpi"><div class="k">Média até 1ª resposta</div><div class="v">${avgFirst!==null?fmtMs(avgFirst):"—"}</div></div>
      <div class="kpi"><div class="k">Respondida mais rápido</div><div class="v">${fastest?("Q"+S.questions[fastest.i].n):"—"}<small> ${fastest?Math.round(fastest.at/1000)+"s ativos":""}</small></div></div>
      <div class="kpi"><div class="k">Maior intervalo até 1ª resposta</div><div class="v">${maxGap.i!==null?("Q"+S.questions[maxGap.i].n):"—"}<small> ${maxGap.i!==null?fmtMs(maxGap.gap):""}</small></div></div>
      <div class="kpi"><div class="k">Não respondidas</div><div class="v">${unansweredIdxs.length}</div></div>
      <div class="kpi"><div class="k">Respostas alteradas</div><div class="v">${changedIdxs.length}</div></div>
    </div>
    <p class="note" style="margin:0 0 10px">
      <b>Tempo ativo</b> = tempo em que a questão esteve visível na tela enquanto a prova estava em andamento (atualizado a cada 0,5s).
      <b>1ª resposta</b> = instante da primeira seleção. <b>Última alteração</b> = instante da última troca de alternativa.
      Vermelho na tabela = resposta incorreta; amarelo = resposta certa em questão que ficou entre as 20% mais lentas.
    </p>

    <h4 style="margin:14px 0 6px">Análise por categoria</h4>
    <table class="cat-tbl">
      <thead><tr><th>Categoria</th><th class="num">Pts</th><th class="num">%</th><th class="num">Tempo médio (1ª resp.)</th><th class="num">Acertos</th><th class="num">Erros</th></tr></thead>
      <tbody>${catRows}</tbody>
    </table>

    <h4 style="margin:16px 0 6px">Tabela individual das 50 questões</h4>
    <div class="timing-table-wrap">
      <table class="timing-table">
        <thead><tr>
          <th>Q</th><th>Texto</th><th>Tipo</th><th>Resp. final</th><th>Resultado</th>
          <th>1ª resposta</th><th>Última alteração</th><th>Tempo ativo</th><th>Alterações</th>
        </tr></thead>
        <tbody>${rowsHtml}</tbody>
      </table>
    </div>
  </section>`;
}

/* ============================================================
   EVENTOS
   ============================================================ */
document.addEventListener("click", e=>{
  // Abrir simulado
  const open = e.target.closest("[data-open]");
  if(open){
    const id = open.dataset.open;
    if(id === "full"){
      if(location.hash === "#/full") startFullExam(); else location.hash = "#/full";
    } else {
      const nid = +id;
      if(location.hash === "#/t"+nid) startTest(nid); else location.hash = "#/t"+nid;
    }
    return;
  }
  if(e.target.id === "startBtn"){ beginTest(); return; }

  // Voltar ao início
  if(e.target.closest("[data-home]") || e.target.closest("#brand")){
    if(S && !S.submitted && S.answers.some(a=>a!==null) && !confirm("Sair do simulado? Suas respostas serão perdidas.")) return;
    location.hash = "#/"; if(!S) renderHome();
    return;
  }
  // Trocar idioma
  const lg = e.target.closest("[data-lang]");
  if(lg){
    lang = lg.dataset.lang; lsSet("lang", lang);
    const y = window.scrollY;
    if(S){
      if(S.mode==='single'){ renderSingleTest(); }
      else { renderFullExam(); }
      // Reaplica estado "submitted" se necessário
      if(S.submitted){
        // Re-render resultado fica perdido; mais simples: recarregar a rota
        if(S.mode==='single') startTest(S.testId); else startFullExam();
      }
      window.scrollTo(0, y);
    } else {
      renderHome();
    }
    return;
  }
  if(e.target.id === "submit"){ submit(); return; }

  // Nav toggle
  if(e.target.id === "navToggle"){ openNav(); return; }
  if(e.target.id === "navClose"){ closeNav(); return; }
  if(e.target === navOverlay){ closeNav(); return; }

  const jump = e.target.closest("[data-jump]");
  if(jump){ jumpToQuestion(+jump.dataset.jump); return; }
});

document.getElementById("brand").addEventListener("keydown", e=>{
  if(e.key==="Enter" || e.key===" "){ e.preventDefault(); e.target.click(); }
});

// Mudança de alternativa
document.addEventListener("change", e=>{
  if(!e.target.matches('.opt input[type=radio]')) return;
  if(!S || !S.started || S.submitted) return;
  const i = +e.target.name.slice(1);
  const j = +e.target.value;
  const wasAnswered = S.answers[i] !== null;
  const changed = wasAnswered && S.answers[i] !== j;

  S.answers[i] = j;
  const tinfo = S.timing[i];
  const elapsed = getElapsedMs();
  if(tinfo.firstAnswerAt === null){
    tinfo.firstAnswerAt = elapsed;
  }
  tinfo.lastChangeAt = elapsed;
  tinfo.changeCount += 1;
  tinfo.answered = true;

  // Atualiza classes visuais
  document.querySelectorAll(`#q${i} .opt`).forEach((lab,k)=>{
    lab.classList.toggle("sel", k===j);
  });
  updateCount();
  updateProgress();
  refreshNavPanel();
});

// Ao rolar, também atualiza a questão ativa (para o painel refletir)
let scrollThrottle = null;
window.addEventListener("scroll", ()=>{
  if(!S || !S.started || S.submitted) return;
  if(scrollThrottle) return;
  scrollThrottle = setTimeout(()=>{
    scrollThrottle = null;
    const idx = findMostVisibleQuestionIdx();
    if(idx !== null && idx !== S.activeQ){
      // acumula imediatamente
      accumulateActiveTime();
      refreshNavPanel();
    }
  }, 250);
}, {passive:true});

/* ============================================================
   ROTEAMENTO
   ============================================================ */
function route(){
  const mFull = location.hash === "#/full";
  const mTest = location.hash.match(/^#\/t(\d+)$/);
  if(mFull) startFullExam();
  else if(mTest) startTest(+mTest[1]);
  else renderHome();
}
window.addEventListener("hashchange", route);
route();
</script>
