function excerpt(q, texts){
  if(q.p==null) return "";
  const txt = texts[q.textIdx].paras[q.p];
  const fallback = `<blockquote class="ex"><span class="pn">${q.p+1}</span><span>${txt}</span></blockquote>`;
  if(q.t==="para") return fallback;
  if(!q.m) return fallback;
  const i = txt.indexOf(q.m);
  if(i<0) return fallback;
  let mid;
  if(q.t==="sent"){ mid = `<mark>${q.m}</mark>`; }
  else {
    // Destaca só q.w dentro de q.m (com fallback caso não encontre)
    const inner = q.m.replace(q.w, `\u0001${q.w}\u0002`);
    const withMark = inner.replace(/\u0001(.+?)\u0002/,'<mark>$1</mark>');
    mid = withMark;
    if(!withMark.includes("<mark>")){ mid = `<mark>${q.m}</mark>`; }
  }
  return `<blockquote class="ex"><span class="pn">${q.p+1}</span><span>${txt.slice(0,i)}${mid}${txt.slice(i+q.m.length)}</span></blockquote>`;
}

